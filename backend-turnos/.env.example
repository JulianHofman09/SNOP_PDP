# Copiá este archivo como .env y completá los valores

# URL de tu proyecto en Supabase (la encontrás en Settings > API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave anon de Supabase (Settings > API > anon public)
SUPABASE_ANON_KEY=tu_clave_anon_aqui

# Clave secreta para firmar los JWT (inventá una cadena larga)
JWT_SECRET=una_clave_secreta_muy_larga_aqui

# Puerto donde corre el servidor
PORT=3001
