# ── Copiá este archivo como .env y completá los valores ──

# 1. URL de tu proyecto Supabase
#    Supabase > Settings > API > Project URL
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co

# 2. Clave anon (pública) de Supabase
#    Supabase > Settings > API > anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Clave secreta para firmar los JWT de tu app
#    Inventá cualquier texto largo y secreto
JWT_SECRET=mi_clave_super_secreta_123456

# 4. Puerto del servidor
PORT=3001
